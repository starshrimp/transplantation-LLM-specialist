# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud → app → Settings → Secrets. Never commit the real file.

[storage]
# "google" -> Google Sheet (default; works on Streamlit Community Cloud)
# "local"  -> a plain .xlsx on disk (development / offline)
backend = "google"

# ---------------------------------------------------------------------------
# Google Sheets backend
# ---------------------------------------------------------------------------
[gsheets]
# Use the sheet's key (the long id in its URL) OR the full URL — one of them.
spreadsheet_id = "1AbCdEf...your-sheet-id..."
# spreadsheet_url = "https://docs.google.com/spreadsheets/d/.../edit"
worksheet = "Evaluations"

# Paste the service-account JSON key fields here (from the downloaded .json).
[gcp_service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "eval-bot@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."

# ---------------------------------------------------------------------------
# Local Excel backend (only when backend = "local")
# ---------------------------------------------------------------------------
# [storage]
# backend = "local"
# local_path = "evaluations.xlsx"
